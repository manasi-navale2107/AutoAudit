# ============================================================
# AUTOAUDIT — ENVIRONMENT CONFIGURATION TEMPLATE
#
# Copy this file to .env for your local configuration.
# Keep real API keys only in .env.
# Never commit .env to Git.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=AutoAudit
APP_ENV=development
DEBUG=false

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO


# ------------------------------------------------------------
# LLM PROVIDER
#
# Supported values: groq, ollama
# Provider and model selection will be recorded per run.
# ------------------------------------------------------------

LLM_PROVIDER=groq

LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2


# ------------------------------------------------------------
# GROQ
#
# Fill these values in .env.
# GROQ_MODEL must be a model ID available to your Groq account.
# API keys must never be sent to the browser.
# ------------------------------------------------------------

GROQ_API_KEY=
GROQ_MODEL=


# ------------------------------------------------------------
# OLLAMA
#
# OLLAMA_MODEL must match a model installed on your machine.
# ------------------------------------------------------------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192


# ------------------------------------------------------------
# LANGUAGE
#
# Supported values: en, mr, hi
# Users can change the conversation language in the interface.
# ------------------------------------------------------------

DEFAULT_LANGUAGE=mr


# ------------------------------------------------------------
# LOCAL STORAGE
#
# Resolve relative paths against the project root in config.py.
# Keep application metadata and graph checkpoints separate.
# ------------------------------------------------------------

RUNTIME_DIR=runtime

APP_DATABASE_PATH=runtime/database/autoaudit.sqlite3
CHECKPOINT_DATABASE_PATH=runtime/database/checkpoints.sqlite3


# ------------------------------------------------------------
# UPLOAD LIMITS
#
# Initial dataset support: CSV.
# Validate these limits on the backend.
# ------------------------------------------------------------

MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200


# ------------------------------------------------------------
# WORKFLOW LIMITS
# ------------------------------------------------------------

MAX_CONCURRENT_RUNS=1
MAX_PLAN_REVISIONS=5
GRAPH_RECURSION_LIMIT=50


# ------------------------------------------------------------
# MACHINE LEARNING DEFAULTS
#
# Fractions refer to the complete dataset:
# Training = 60%, validation = 20%, final test = 20%.
#
# Split strategy must also account for groups and time.
# Final test data must not guide model selection or repairs.
# ------------------------------------------------------------

RANDOM_SEED=42

VALIDATION_SIZE=0.20
TEST_SIZE=0.20

TRAINING_TIMEOUT_SECONDS=600
MODEL_N_JOBS=2


# ------------------------------------------------------------
# VOICE INPUT
#
# Enable after installing and implementing the voice module.
# CPU + int8 is the initial execution configuration.
# ------------------------------------------------------------

VOICE_ENABLED=false

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_AUDIO_UPLOAD_MB=10
MAX_AUDIO_DURATION_SECONDS=60